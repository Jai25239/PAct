{
  "stage": "structured_latent",
  "models": {
    "denoiser": {
      "name": "SLatFlowModel",
      "args": {
        "resolution": 8,
        "in_channels": 2,
        "out_channels": 2,
        "model_channels": 32,
        "cond_channels": 1024,
        "num_blocks": 2,
        "num_heads": 4,
        "mlp_ratio": 2,
        "patch_size": 2,
        "num_io_res_blocks": 1,
        "io_block_channels": [
          16
        ],
        "pe_mode": "ape",
        "qk_rms_norm": true,
        "use_fp16": false,
        "use_checkpoint": false
      }
    },
    "Articulation": {
      "name": "ArticulationRegressionHead",
      "args": {
        "input_layer_num": 2,
        "out_layer_num": 2,
        "feat_dim": 32,
        "out_channel": 24,
        "num_heads": 4,
        "mlp_ratio": 2,
        "num_arti_blocks": 0,
        "use_skip_connection": false,
        "use_checkpoint": false,
        "share_mod": false,
        "qk_rms_norm": true,
        "qk_rms_norm_cross": false,
        "use_art_as_input": false,
        "use_fp16": false
      }
    }
  },
  "dataset": {
    "name": "synthetic",
    "args": {}
  },
  "trainer": {
    "name": "ImageConditionedSparseFlowMatchingCFGTrainer_Articulation",
    "args": {
      "lora_setting": {
        "use_lora": false,
        "name": "denoiser",
        "args": {}
      },
      "masked_articulation_loss": true,
      "arti_info_diffusion": false,
      "finetune_ckpt": null,
      "max_steps": 1,
      "model_version": "Arti_stage2_flow",
      "batch_size_per_gpu": 1,
      "batch_split": 1,
      "num_workers": 0,
      "optimizer": {
        "name": "AdamW",
        "args": {
          "lr": 0.001
        }
      },
      "ema_rate": [
        0.9
      ],
      "fp16_mode": null,
      "grad_clip": 1,
      "i_print": 1,
      "i_log": 1,
      "i_sample": 1000,
      "i_save": 1,
      "i_validate": -1,
      "p_uncond": 0.1,
      "t_schedule": {
        "name": "uniform",
        "args": {}
      },
      "sigma_min": 0.00001,
      "image_cond_model": "dinov2_vitl14_reg"
    }
  }
}
